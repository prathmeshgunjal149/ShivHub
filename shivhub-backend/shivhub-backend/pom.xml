<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- =========================================================
         MAVEN MODEL
         ========================================================= -->

    <modelVersion>4.0.0</modelVersion>


    <!-- =========================================================
         SPRING BOOT PARENT
         ========================================================= -->

    <parent>

        <groupId>
            org.springframework.boot
        </groupId>

        <artifactId>
            spring-boot-starter-parent
        </artifactId>

        <version>
            4.1.1
        </version>

        <relativePath/>

    </parent>


    <!-- =========================================================
         PROJECT INFORMATION
         ========================================================= -->

    <groupId>
        com.shivhub
    </groupId>

    <artifactId>
        shivhub-backend
    </artifactId>

    <version>
        0.0.1-SNAPSHOT
    </version>

    <name>
        shivhub-backend
    </name>

    <description>
        ShivHub E-Commerce Backend
    </description>


    <!-- =========================================================
         JAVA VERSION
         ========================================================= -->

    <properties>

        <java.version>
            17
        </java.version>

    </properties>


    <!-- =========================================================
         DEPENDENCIES
         ========================================================= -->

    <dependencies>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>


        <!-- =====================================================
             SPRING DATA JPA
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-data-jpa
            </artifactId>

        </dependency>


        <!-- =====================================================
             SPRING SECURITY
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-security
            </artifactId>

        </dependency>


        <!-- =====================================================
             SPRING VALIDATION
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-validation
            </artifactId>

        </dependency>


        <!-- =====================================================
             SPRING WEB MVC
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-webmvc
            </artifactId>

        </dependency>


        <!-- =====================================================
             CLASSIC JACKSON DATABIND
             =====================================================

             Some ShivHub services use com.fasterxml.jackson.databind
             directly for manual JSON parsing and compatibility with
             existing JWT/Jackson code.

             ===================================================== -->

        <dependency>

            <groupId>
                com.fasterxml.jackson.core
            </groupId>

            <artifactId>
                jackson-databind
            </artifactId>

            <version>
                2.20.2
            </version>

        </dependency>

        <!-- Razorpay is used only by backend services. The key secret never reaches React. -->
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>1.4.10</version>
        </dependency>


        <!-- =====================================================
             MYSQL DRIVER
             ===================================================== -->

        <dependency>

            <groupId>
                com.mysql
            </groupId>

            <artifactId>
                mysql-connector-j
            </artifactId>

            <scope>
                runtime
            </scope>

        </dependency>


        <!-- =====================================================
             LOMBOK
             ===================================================== -->

        <dependency>

            <groupId>
                org.projectlombok
            </groupId>

            <artifactId>
                lombok
            </artifactId>

            <version>
                1.18.46
            </version>

            <scope>
                provided
            </scope>

        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- =====================================================
             JWT API
             ===================================================== -->

        <dependency>

            <groupId>
                io.jsonwebtoken
            </groupId>

            <artifactId>
                jjwt-api
            </artifactId>

            <version>
                0.12.6
            </version>

        </dependency>


        <!-- =====================================================
             JWT IMPLEMENTATION
             ===================================================== -->

        <dependency>

            <groupId>
                io.jsonwebtoken
            </groupId>

            <artifactId>
                jjwt-impl
            </artifactId>

            <version>
                0.12.6
            </version>

            <scope>
                runtime
            </scope>

        </dependency>


        <!-- =====================================================
             JWT JACKSON
             ===================================================== -->

        <dependency>

            <groupId>
                io.jsonwebtoken
            </groupId>

            <artifactId>
                jjwt-jackson
            </artifactId>

            <version>
                0.12.6
            </version>

            <scope>
                runtime
            </scope>

        </dependency>


        <!-- =====================================================
             SPRING MAIL
             =====================================================

             Used for:

             - Customer email
             - Seller email
             - OTP email
             - Invoice PDF email
             - Marketing email

             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-mail
            </artifactId>

        </dependency>


        <!-- =====================================================
             OPENPDF
             =====================================================

             Used for:

             - Offline bill PDF
             - GST invoice PDF
             - Order invoice PDF
             - Email invoice attachment

             IMPORTANT:
             This is OpenPDF, so Java imports must use:

             com.lowagie.text.*
             com.lowagie.text.pdf.*

             NOT:

             com.itextpdf.*

             ===================================================== -->

        <dependency>

            <groupId>
                com.github.librepdf
            </groupId>

            <artifactId>
                openpdf
            </artifactId>

            <version>
                2.0.3
            </version>

        </dependency>


        <!-- =====================================================
             TEST - JPA
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-data-jpa-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <!-- =====================================================
             TEST - SECURITY
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-security-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <!-- =====================================================
             TEST - VALIDATION
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-validation-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <!-- =====================================================
             TEST - WEB MVC
             ===================================================== -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-webmvc-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


    </dependencies>


    <!-- =========================================================
         BUILD CONFIGURATION
         ========================================================= -->

    <build>

        <!--
            Some local Windows tooling is removing .class files from the
            conventional target directory after compilation. Keep Maven's
            generated output in a project-local build directory so the
            Spring Boot run goal can reliably load the application class.
        -->
        <directory>${project.basedir}/.shivhub-build</directory>

        <plugins>


            <!-- =================================================
                 SPRING BOOT MAVEN PLUGIN
                 ================================================= -->

            <plugin>

                <groupId>
                    org.springframework.boot
                </groupId>

                <artifactId>
                    spring-boot-maven-plugin
                </artifactId>

                <configuration>

                    <mainClass>
                        com.shivhub.backend.ShivhubBackendApplication
                    </mainClass>

                </configuration>

            </plugin>


            <!--
                Avoid Surefire's manifest-only test classpath on Windows. The
                generated manifest contains absolute paths and can prevent the
                forked test JVM from starting when its path root differs from
                Maven's working directory.
            -->
            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-surefire-plugin
                </artifactId>

                <configuration>

                    <useManifestOnlyJar>
                        false
                    </useManifestOnlyJar>

                </configuration>

            </plugin>


            <!-- =================================================
                 MAVEN COMPILER PLUGIN
                 ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-compiler-plugin
                </artifactId>

                <configuration>

                    <!--
                        Use the JDK's javac process on Windows. The in-process compiler can
                        report generated files in Maven status metadata while leaving
                        target/classes empty, which then makes spring-boot:run fail to find
                        the configured main class.
                    -->
                    <fork>true</fork>

                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>

                    <annotationProcessorPaths>


                        <!-- =====================================
                             LOMBOK ANNOTATION PROCESSOR
                             ===================================== -->

                        <path>

                            <groupId>
                                org.projectlombok
                            </groupId>

                            <artifactId>
                                lombok
                            </artifactId>

                            <version>
                                1.18.46
                            </version>

                        </path>


                    </annotationProcessorPaths>

                </configuration>

            </plugin>


        </plugins>

    </build>


</project>
